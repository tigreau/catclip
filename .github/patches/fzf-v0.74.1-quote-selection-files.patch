+func TestFilePlaceholderQuotingAndCleanup(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "fzf temp 'é' $name %name% !bang! {q}")
+	if err := os.Mkdir(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range []string{"TMPDIR", "TMP", "TEMP"} {
+		t.Setenv(key, dir)
+	}
+	executor := util.NewExecutor("")
+	item := newItem("literal 'row' $name")
+	for _, template := range []string{"{f}", "{+f}", "{rf}", "{+rf}"} {
+		t.Run(template, func(t *testing.T) {
+			command, files := replacePlaceholder(replacePlaceholderParams{
+				template: template, executor: executor, printsep: "\n",
+				allItems: [3][]*Item{{item}, {item}, nil},
+			})
+			if len(files) != 1 {
+				t.Fatalf("expected one temporary file, got %q", files)
+			}
+			defer removeFiles(files)
+			want := executor.QuoteEntry(files[0])
+			if strings.Contains(template, "r") {
+				want = files[0]
+			}
+			if command != want {
+				t.Fatalf("replacement=%q want=%q", command, want)
+			}
+			data, err := os.ReadFile(files[0])
+			if err != nil || string(data) != "literal 'row' $name\n" {
+				t.Fatalf("selection contents changed: %q, %v", data, err)
+			}
+			removeFiles(files)
+			if _, err := os.Stat(files[0]); !os.IsNotExist(err) {
+				t.Fatalf("raw cleanup path did not remove file: %v", err)
+			}
+		})
+	}
+}
