diff --git a/src/util/executor_windows_test.go b/src/util/executor_windows_test.go
new file mode 100644
--- /dev/null
+++ b/src/util/executor_windows_test.go
@@ -0,0 +1,110 @@
+package util
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestMain(m *testing.M) {
+	if path := os.Getenv("FZF_EXECUTOR_ARGV_PROBE"); path != "" {
+		data, err := json.Marshal(os.Args[1:])
+		if err == nil {
+			err = os.WriteFile(path, data, 0o600)
+		}
+		if err != nil {
+			os.Exit(1)
+		}
+		os.Exit(0)
+	}
+	os.Exit(m.Run())
+}
+
+func TestCustomShellRetainsExecutorTypeAndArguments(t *testing.T) {
+	for _, tt := range []struct {
+		command string
+		shell   string
+		kind    shellType
+		args    []string
+	}{
+		{"cmd /d /s /c", "cmd", shellTypeCmd, []string{"/d", "/s", "/c"}},
+		{"powershell -NoProfile -NonInteractive -Command", "powershell", shellTypePowerShell, []string{"-NoProfile", "-NonInteractive", "-Command"}},
+		{"pwsh -NoProfile -Command", "pwsh", shellTypePwsh, []string{"-NoProfile", "-Command"}},
+		{"bash --noprofile -c", "bash", shellTypeUnknown, []string{"--noprofile", "-c"}},
+		{`"C:\Program Files\PowerShell\7\pwsh.exe" -NoProfile -Command`, `C:\Program Files\PowerShell\7\pwsh.exe`, shellTypePwsh, []string{"-NoProfile", "-Command"}},
+	} {
+		t.Run(tt.shell, func(t *testing.T) {
+			t.Setenv("SHELL", "unrelated-default-shell")
+			custom := NewExecutor(tt.command)
+			if custom.shell != tt.shell || custom.shellType != tt.kind || !reflect.DeepEqual(custom.args, tt.args) {
+				t.Fatalf("custom executor changed: %+v", custom)
+			}
+			t.Setenv("SHELL", tt.shell)
+			automatic := NewExecutor("")
+			for _, value := range []string{"", "space path", `C:\path\file`, `it's $name %name% !bang!`, `double "quotes"`} {
+				if custom.QuoteEntry(value) != automatic.QuoteEntry(value) {
+					t.Fatalf("custom shell lost quoting for %q: got %q want %q", value, custom.QuoteEntry(value), automatic.QuoteEntry(value))
+				}
+			}
+		})
+	}
+}
+
+func TestCustomShellNativeArgumentRoundTrip(t *testing.T) {
+	shell := os.Getenv("FZF_EXECUTOR_TEST_SHELL")
+	if shell == "" {
+		t.Skip("native shell executor supplied by cross-shell CI")
+	}
+	base := strings.ToLower(filepath.Base(shell))
+	args := " --noprofile --norc -c"
+	switch {
+	case strings.HasPrefix(base, "cmd"):
+		args = " /d /s /c"
+	case strings.HasPrefix(base, "pwsh"), strings.HasPrefix(base, "powershell"):
+		args = " -NoProfile -NonInteractive -Command"
+	}
+	t.Setenv("SHELL", "not-the-requested-shell")
+	executor := NewExecutor(`"` + shell + `"` + args)
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	dir := filepath.Join(t.TempDir(), "executor 'é' $name %name% !bang! {q}")
+	if err := os.Mkdir(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	helper := filepath.Join(dir, "probe.exe")
+	data, err := os.ReadFile(self)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(helper, data, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("FZF_EXECUTOR_HELPER", helper)
+	prefix := executor.QuoteEntry(helper)
+	if strings.HasPrefix(base, "cmd") {
+		prefix = `"%FZF_EXECUTOR_HELPER%"`
+	} else if strings.HasPrefix(base, "pwsh") || strings.HasPrefix(base, "powershell") {
+		prefix = "& " + prefix
+	}
+	for _, value := range []string{`C:\path with spaces\scope.json`, `it's $name %name% !bang! {q}`, `trailing\`, "Unicode é"} {
+		resultPath := filepath.Join(t.TempDir(), "received.json")
+		t.Setenv("FZF_EXECUTOR_ARGV_PROBE", resultPath)
+		out, err := executor.ExecCommand(prefix+" "+executor.QuoteEntry(value), false).CombinedOutput()
+		if err != nil {
+			t.Fatalf("custom shell failed for %q: %v: %s", value, err, out)
+		}
+		var got []string
+		data, err := os.ReadFile(resultPath)
+		if err == nil {
+			err = json.Unmarshal(data, &got)
+		}
+		if err != nil || !reflect.DeepEqual(got, []string{value}) {
+			t.Fatalf("custom shell changed argv: %s, %v; want %q; output: %s", data, err, value, out)
+		}
+	}
+}
